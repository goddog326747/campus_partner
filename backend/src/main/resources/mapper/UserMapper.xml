<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.project.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.project.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="bio" property="bio"/>
        <result column="location" property="location"/>
        <result column="school" property="school"/>
        <result column="school_email" property="schoolEmail"/>
        <result column="verified" property="verified"/>
        <result column="verify_time" property="verifyTime"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="wechat" property="wechat"/>
        <result column="qq" property="qq"/>
        <result column="status" property="status"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="privacy_profile" property="privacyProfile"/>
        <result column="privacy_contact" property="privacyContact"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, nickname, avatar, gender, birthday, bio, location, school,
        school_email, verified, verify_time, phone, email, wechat, qq, status, last_login_time,
        privacy_profile, privacy_contact, create_time, update_time
    </sql>

    <!-- 根据ID查询用户 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 查询所有用户 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
    </select>

    <!-- 插入用户 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (
            username, password, nickname, avatar, gender, birthday, bio, location, school,
            school_email, verified, verify_time, phone, email, wechat, qq, status, last_login_time,
            privacy_profile, privacy_contact, create_time, update_time
        ) VALUES (
            #{username}, #{password}, #{nickname}, #{avatar}, #{gender}, #{birthday}, #{bio},
            #{location}, #{school}, #{schoolEmail}, #{verified}, #{verifyTime}, #{phone},
            #{email}, #{wechat}, #{qq}, #{status}, #{lastLoginTime}, #{privacyProfile},
            #{privacyContact}, #{createTime}, #{updateTime}
        )
    </insert>

    <!-- 更新用户 -->
    <update id="update">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="bio != null">bio = #{bio},</if>
            <if test="location != null">location = #{location},</if>
            <if test="school != null">school = #{school},</if>
            <if test="schoolEmail != null">school_email = #{schoolEmail},</if>
            <if test="verified != null">verified = #{verified},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="wechat != null">wechat = #{wechat},</if>
            <if test="qq != null">qq = #{qq},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastLoginTime != null">last_login_time = #{lastLoginTime},</if>
            <if test="privacyProfile != null">privacy_profile = #{privacyProfile},</if>
            <if test="privacyContact != null">privacy_contact = #{privacyContact},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除用户 -->
    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>

</mapper>
